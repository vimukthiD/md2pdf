{
  "name": "@vimukthid/md2pdf",
  "version": "2.0.2",
  "description": "A configurable command-line utility that converts Markdown files to professionally formatted PDFs with customizable styling, headers, footers, and themes",
  "main": "src/index.js",
  "bin": {
    "md2pdf": "./bin/md2pdf.js"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ bin/ --ext .js",
    "lint:fix": "eslint src/ bin/ --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"bin/**/*.js\"",
    "prepublishOnly": "npm test && npm run lint"
  },
  "keywords": [
    "markdown",
    "pdf",
    "converter",
    "md2pdf",
    "markdown-to-pdf",
    "document",
    "cli",
    "puppeteer",
    "html-to-pdf",
    "documentation"
  ],
  "author": "Vimukthi Dissanayake <dissanayake.kasun@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vimukthiD/md2pdf.git"
  },
  "bugs": {
    "url": "https://github.com/vimukthiD/md2pdf/issues"
  },
  "homepage": "https://github.com/vimukthiD/md2pdf#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "bin/",
    "src/",
    "themes/",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "ajv": "8.20.0",
    "chalk": "4.1.2",
    "commander": "14.0.3",
    "highlight.js": "11.11.1",
    "markdown-it": "14.1.1",
    "ora": "5.4.1",
    "puppeteer": "25.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "jest": "30.4.2",
    "prettier": "3.8.3"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "flatted": "3.4.2"
  }
}
